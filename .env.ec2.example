STATUS_DOMAIN=status.hokus.ai
ACME_EMAIL=ops@example.com

STATE_BACKEND=postgres
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/mttr?sslmode=require
POOLED_DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/mttr?sslmode=require
DATABASE_SSL=true
DATABASE_MAX_CONNECTIONS=2

OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
INVESTIGATE_MODEL=openai/gpt-5.4
INVESTIGATE_MODEL_FALLBACK=anthropic/claude-3.5-sonnet

HEALTH_REPORT_S3_URI=s3://hokusai-health-reports-development/latest/development/report.md
AWS_REGION=us-east-1
MONITOR_INTERVAL_MS=900000

SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=status

# Defaults to ~/.aws. On EC2, prefer an instance profile and leave this unset.
AWS_CONFIG_DIR=${HOME}/.aws
