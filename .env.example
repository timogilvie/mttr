# Required
OPENROUTER_API_KEY=your_api_key_here

# Optional - defaults provided
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
HEALTH_REPORT_S3_URI=s3://hokusai-health-reports-development/latest/development/report.md
AWS_REGION=us-east-1
MONITOR_INTERVAL_MS=900000
LLM_TIMEOUT_MS=60000
S3_TIMEOUT_MS=15000
WEB_HOST=0.0.0.0
WEB_PORT=3000

# State backend. Use file locally; use postgres for the continuous-monitoring server.
STATE_BACKEND=file
AGENT_STATE_PATH=.mttr-state.json
DATABASE_URL=
POOLED_DATABASE_URL=
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=4
DATABASE_IDLE_TIMEOUT_MS=30000

# Slack alerting. Leave SLACK_WEBHOOK_URL empty to disable delivery.
SLACK_WEBHOOK_URL=
SLACK_ALERT_CHANNEL=slack
SLACK_ALERT_TIMEOUT_MS=10000

# OpenRouter rate-limit / backoff (429/5xx)
OPENROUTER_MAX_RETRIES=4
OPENROUTER_BACKOFF_BASE_MS=1000
OPENROUTER_BACKOFF_MAX_MS=30000

# Investigate stage - model (must support tool/function calling)
INVESTIGATE_MODEL=openai/gpt-5.4
INVESTIGATE_MODEL_FALLBACK=anthropic/claude-3.5-sonnet

# Investigate stage - tool-loop budgets (bound cost/runtime)
INVESTIGATE_MAX_TOOL_ITERATIONS=6
INVESTIGATE_MAX_TOOL_CALLS=12
INVESTIGATE_CLOSURE_ENABLED=true
INVESTIGATE_CLOSURE_MAX_TOOL_ITERATIONS=2
INVESTIGATE_CLOSURE_MAX_TOOL_CALLS=3
INVESTIGATE_CONSECUTIVE_FAILURE_LIMIT=3
INVESTIGATE_LLM_TIMEOUT_MS=120000

# Investigate stage - per-tool limits
TOOL_TIMEOUT_MS=20000
TOOL_RESULT_MAX_CHARS=8000
TOOL_DEFAULT_LOOKBACK_MINUTES=60
TOOL_MAX_LOOKBACK_MINUTES=1440
TOOL_MAX_CONCURRENCY=2

# AWS SDK retry (adaptive throttling backoff)
AWS_MAX_ATTEMPTS=5

# Alarm-triggered investigate loop (ships dark; ALARM_WEBHOOK_ENABLED=false by default).
# ALARM_WEBHOOK_PATH_TOKEN and ALARM_WEBHOOK_TOPIC_ARN are both required when ALARM_WEBHOOK_ENABLED=true.
# ALARM_WEBHOOK_TOPIC_ARN binds ingress to one expected SNS topic; notifications from any other topic are rejected.
ALARM_WEBHOOK_ENABLED=false
ALARM_WEBHOOK_PATH_TOKEN=
ALARM_WEBHOOK_TOPIC_ARN=
ALARM_WEBHOOK_VERIFY_SIGNATURE=true
ALARM_WEBHOOK_AUTOCONFIRM=true
ALARM_TRIGGER_MIN_SEVERITY=CRITICAL
ALARM_TRIGGER_COOLDOWN_MS=600000
ALARM_TRIGGER_POLL_MS=5000
ALARM_TRIGGER_COALESCE_MS=2000
